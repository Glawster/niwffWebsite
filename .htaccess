# NIWFF Apache root deployment rules
# The Git checkout is the staging document root. Keep project archives and Git private.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve source control, historical data, scripts, tests or documents.
  RewriteRule ^(?:\.git|\.github|data|documentation|project|scripts|tests|output)(?:/|$) - [F,END,NC]

  # Legacy links redirect to new sections on staging.
  RewriteRule ^player-profiles/?$ /international-teams/ [R=302,L,NC]
  RewriteRule ^latest-news/?$ /news/ [R=302,L,NC]
  RewriteRule ^affiliated-clubs/?$ /find-a-club/ [R=302,L,NC]
  RewriteRule ^gallery/?$ /news/ [R=302,L,NC]
</IfModule>

# Block hidden files (including .env and .htpasswd) without interfering with\n# requests for ACME tokens inside the .well-known directory.\n<FilesMatch "^\\.">\n  Require all denied\n</FilesMatch>\n\n# Also block direct requests for project metadata and non-public source formats.
<FilesMatch "(?i)^(?:README\.md|REQUIREMENTS\.md|\.gitignore|\.gitattributes|composer\.json|package(?:-lock)?\.json|pyproject\.toml|.*\.(?:md|markdown|ya?ml|toml|ini|conf|log|sql|sqlite|db|py|sh|json))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
